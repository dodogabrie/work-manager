# Copia in .env e personalizza. Non committare mai .env.
POSTGRES_USER=workplanner
POSTGRES_PASSWORD=workplanner
POSTGRES_DB=workplanner
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Hash argon2 della password owner. Genera con:
#   docker compose run --rm backend python -m app.cli hash-password
OWNER_PASSWORD_HASH=

# Segreto per firmare i cookie di sessione. Genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# URL pubblico, usato per costruire i link manager e i feed ICS
PUBLIC_BASE_URL=http://localhost:8000
# Vuoto in sviluppo: il frontend passa dal proxy Vite (stesso origin).
# In produzione, solo se il frontend è servito da un dominio diverso dal backend.
VITE_API_BASE=

TZ=Europe/Rome

# Origini ammesse dal browser (frontend). In produzione: https://<sottodominio>
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dove finiscono i PDF/PNG generati dai report (§20)
REPORTS_DIR=reports_out
